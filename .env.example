# ── Core ────────────────────────────────────────────────────────────────────
# Where the app runs. "development" enables /docs and verbose logging;
# "production" hides the schema and requires a real SECRET_KEY.
ENVIRONMENT=development

# Signing key for session and audio tokens. MUST be changed in production.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-you-deploy-this-anywhere-real

# How long a login lasts, in minutes. Default 7 days.
ACCESS_TOKEN_MINUTES=10080

# How long an audio capability link stays valid, in minutes. Default 1 hour.
# Short on purpose: the link is in a URL and URLs leak into logs and history.
AUDIO_TOKEN_MINUTES=60

# ── Database ────────────────────────────────────────────────────────────────
# SQLite by default so the project runs with no setup at all.
# For PostgreSQL (what docker-compose uses):
#   DATABASE_URL=postgresql+psycopg://nawa:nawa@db:5432/nawa
DATABASE_URL=sqlite:///./nawa.db

# ── Limits ──────────────────────────────────────────────────────────────────
# Generations allowed per user per day.
DAILY_GENERATION_LIMIT=40

# Maximum characters accepted in one generation.
MAX_TEXT_CHARS=4000

# Set to false only in tests. Leaving it on in production is the point.
RATE_LIMIT_ENABLED=true

# ── Synthesis ───────────────────────────────────────────────────────────────
# How many chunks are synthesised in parallel. Higher is faster but hammers
# the upstream service; 3 is a reasonable balance.
SYNTH_CONCURRENCY=3

# Characters per chunk. Smaller chunks give more natural pauses but more
# round trips. 280 is tuned for paragraph-length scripts.
CHUNK_MAX_CHARS=280

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from a browser.
# Leave empty when the UI is served by this same app (the default).
CORS_ORIGINS=

# ── Demo ────────────────────────────────────────────────────────────────────
# The seed script creates this account. Change it or delete the account
# before putting this anywhere public.
DEMO_EMAIL=demo@nawa.app
DEMO_PASSWORD=nawademo2026
